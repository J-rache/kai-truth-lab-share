{
  "id": "model-tool-use-discipline",
  "name": "Model Tool Use Discipline",
  "description": "Checks model-facing tools exist and are verifiable without relying on chat claims.",
  "checks": [
    { "type": "file_exists", "path": "src/mcp-server.mjs" },
    { "type": "file_exists", "path": "src/tool-promotion.mjs" },
    { "type": "file_exists", "path": "src/failure-inbox.mjs" },
    { "type": "file_exists", "path": "src/proof-bundle.mjs" },
    { "type": "file_exists", "path": "src/repo-redundancy.mjs" },
    { "type": "file_exists", "path": "src/next-work.mjs" },
    { "type": "file_exists", "path": "client-packages/mcp/codex-truth-lab.local.json" },
    {
      "type": "command",
      "command": "node",
      "args": ["--check", "src/mcp-server.mjs"],
      "timeoutMs": 120000,
      "expect": { "exitCode": 0 }
    }
  ]
}
